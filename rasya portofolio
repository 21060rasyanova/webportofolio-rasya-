<!-- JavaScript for Carousel Functionality -->
<script data-purpose="carousel-logic">
    document.addEventListener('DOMContentLoaded', () => {
      const carousel = document.getElementById('showcase-carousel');
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');
      const indicatorDots = document.querySelectorAll('.indicator-dot');
      const totalSlides = 4;
      let currentSlide = 0;

      function updateSlide(index) {
        currentSlide = (index + totalSlides) % totalSlides;
        carousel.style.transform = `translateX(-${currentSlide * 100}%)`;

        // Update dot indicators
        indicatorDots.forEach((dot, idx) => {
          if (idx === currentSlide) {
            dot.classList.remove('w-2', 'bg-slate-700');
            dot.classList.add('w-5', 'bg-brand-blue');
          } else {
            dot.classList.remove('w-5', 'bg-brand-blue');
            dot.classList.add('w-2', 'bg-slate-700');
          }
        });
      }

      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => updateSlide(currentSlide - 1));
        nextBtn.addEventListener('click', () => updateSlide(currentSlide + 1));
      }

      indicatorDots.forEach(dot => {
        dot.addEventListener('click', () => {
          const slideTarget = parseInt(dot.getAttribute('data-slide'), 10);
          updateSlide(slideTarget);
        });
      });
    });
  </script>
